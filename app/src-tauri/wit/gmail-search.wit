package nitra:gmail@0.1.0;

/// Product-owned Gmail host contract. It mirrors `users.messages.list` paging,
/// while leaving Gmail's query language entirely unrestricted.
interface search {
  /// Exact supported subset of Gmail `users.messages.list` request fields.
  record list-request {
    /// Gmail search expression; an empty string has Gmail's normal all-mail meaning.
    q: string,
    /// Optional Gmail API page size. Omitted values use the API default.
    max-results: option<u32>,
    /// Opaque token returned by the previous page.
    page-token: option<string>,
    /// Gmail label identifiers, without any product-imposed default label.
    label-ids: list<string>,
    /// Whether Gmail spam and trash should be included.
    include-spam-trash: option<bool>,
  }

  /// Gmail `Message` reference returned by `users.messages.list`.
  record message-ref {
    id: string,
    thread-id: option<string>,
  }

  /// Page shape returned by Gmail `users.messages.list`.
  record list-response {
    messages: option<list<message-ref>>,
    next-page-token: option<string>,
    result-size-estimate: option<u32>,
  }

  /// Host-owned errors intentionally omit credentials, URLs and HTTP response bodies.
  variant error {
    unauthenticated,
    unavailable,
    invalid-response,
  }

  /// Streams native Gmail list pages until the API omits `nextPageToken`.
  list-pages: async func(request: list-request) -> result<stream<result<list-response, error>>, error>;
}

/// Product-owned Gmail draft creation contract for trusted Components.
interface drafts {
  /// The RFC 822 fields used for the message created inside a Gmail draft.
  record create-request {
    to: string,
    subject: string,
    body: string,
  }

  /// Gmail's opaque draft identifier.
  record draft-ref {
    id: string,
  }

  /// Host-owned errors intentionally omit credentials, URLs and HTTP response bodies.
  variant error {
    unauthenticated,
    unavailable,
    invalid-response,
  }

  /// Creates one Gmail draft with the authenticated account.
  create: async func(request: create-request) -> result<draft-ref, error>;
}

/// Product demo Component that creates one deterministic draft.
interface draft-helper {
  use drafts.{draft-ref, error};

  /// Creates the demo draft through the typed Gmail drafts import.
  create: async func() -> result<draft-ref, error>;
}

/// Demo trigger implemented by the Booking Finder Component.
interface booking-finder {
  use search.{error, message-ref};

  /// Booking-related Gmail message identities returned without message bodies.
  record booking-results {
    /// The unrestricted Gmail query that the Component supplied to the host.
    query: string,
    /// References gathered from all available Gmail result pages.
    messages: list<message-ref>,
  }

  /// Finds messages sent by Booking.com through the typed Gmail search import.
  find: async func() -> result<booking-results, error>;
}

world gmail-plugin {
  import search;
  import drafts;
}

world draft-helper-plugin {
  import drafts;
  export draft-helper;
}

/// Product-local Component entrypoint used by the Booking Finder demo.
world booking-finder-plugin {
  import search;
  export booking-finder;
}
